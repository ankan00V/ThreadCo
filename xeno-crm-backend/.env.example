# ── Database ──────────────────────────────────────────────────────────────
# Owner role: used by the API for normal reads and writes.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Least-privilege role backing the public SQL console and the Performance Lab.
# MUST be a role with SELECT and nothing else. See README → "The SQL console".
# If this is unset the console is disabled rather than falling back to the owner.
DATABASE_URL_READONLY=postgresql://threadco_readonly:password@host:5432/dbname?sslmode=require

# ── AI (NVIDIA NIM, OpenAI-compatible) ────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ── Channel simulator ─────────────────────────────────────────────────────
CHANNEL_STUB_URL=http://localhost:8000/channel/send
CRM_RECEIPT_URL=http://localhost:8000/webhooks/receipt

# Optional: the deployed frontend origin, appended to the CORS allowlist.
FRONTEND_URL=

# ── Voice briefing (ElevenLabs) ───────────────────────────────────────────
# Server-side only. Never expose this to the browser: the frontend calls our
# own endpoint, which synthesises text the server generated. Leave unset to
# disable the voice briefing cleanly.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
